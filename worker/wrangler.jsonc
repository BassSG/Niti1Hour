{
  "name": "niti1hour-valet-staging",
  "main": "index.js",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "assets": {
    "directory": "../apps",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health", "/customer/*", "/admin/*", "/"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "DEMO_MODE": "true",
    "DEPLOYMENT_SHA": "staging"
  }
}
